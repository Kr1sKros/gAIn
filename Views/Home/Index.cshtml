@{
ViewData["Title"] = "Home - Gain";
Layout = "_Layout";
}

<head>
    <link rel="stylesheet" href="/css/welcome.css">
    <link rel="stylesheet" href="/css/home.css">
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&display=swap" rel="stylesheet">

</head>
<style>
    body {
        overflow-x: hidden;
    }
</style>
<body>
<div class="title-section">
    <div class="title-content">
        <h1 class="heading"><em>gAIn</em></h1>
        <p class="undertext">Level up your body. Boost your game.</p>
        <div class="signup-button-container">
            <!-- Background layer -->
            <div class="button-background"></div>

            <!-- Smaller centered overlay -->
            <div class="button-overlay"></div>

            <a class="signup-button" asp-area="Identity" asp-page="/Account/Register">Sign Up For Free</a>
        </div>

    </div>
</div>


<div class="workout-section workouttime">
    <div class="workout-content">
        <div class="text-content">
            <br/>
            <h2>Quick Workouts, Big Results</h2>
            <p><em>Only got 5 minutes? We've got you covered.</em></p>
            <p>
                Choose a workout length (5, 10, 15, or 30 minutes) and let GAIN create a personalized routine.
                No matter how tight your schedule, there’s always time to level up your health.
                Small steps lead to epic rewards.
            </p><!DOCTYPE html>
            <html>
            <head>
                <title>GAIN - Home</title>
                <link rel="stylesheet" href="/css/welcome.css">
                <link rel="stylesheet" href="/css/home.css">
                <link rel="stylesheet" href="/css/stat.css">
            </head>
         
            </html>

            <br/>
        </div>
        <div class="image-content" style="text-align: center; ">
            <img src="/images/workouttime.jpg" alt="Workout Time Options">
        </div>
    </div>
</div>



<br/>
<br/>
<br/>
<br/>
<br/>
<br/>
<br/>
<div class="workout-section streak">
    <div class="workout-content">
        <!-- Left Streak GIF  -->
        <div class="image-content">
            <img src="/images/streak.gif" alt="Workout Streak Left">
        </div>

        <!-- Text Content -->
        <div class="text-content">
            <br/>
            <h2>Unlock Awesome Achievements and Hold Streaks</h2>
            <p><em>How long can you keep your streak alive?</em></p>
            <p>
                Turn fitness into a game! Complete daily workouts to unlock achievements like
                "Hacker" or "God". Hold streaks for bragging rights and leaderboard spots.
                Challenge yourself to a real-life quest and see how far you can go!
            </p>
            <br/>
        </div>

        <!-- Right Streak GIF -->
        <div class="image-content">
            <img src="/images/streak.gif" alt="Workout Streak Right">
        </div>
    </div>
</div>




<br/>
<br/>
<br/>

<br/>
<br/>
<br/>

<br/>
<br/>
<br/>


<div class="workout-section ai-section">
    <div class="workout-content">
        <div class="image-content">
            <img src="https://img.freepik.com/free-vector/ai-technology-microchip-background-vector-digital-transformation-concept_53876-112222.jpg" alt="Workout Time Options">
        </div>
        <div class="text-content">
            <h2>gAin is powered by Artificial Intelligence</h2>
            <p><em>Your personal fitness coach, always ready.</em></p>
            <p>
                With cutting-edge AI technology, GAIN learns about your
                fitness level, available time, and equipment to create the
                perfect workout every time. Whether you’re a beginner or a
                seasoned gamer, the app tailors routines that match your skill
                level and adapt as you improve.
            </p>
        </div>
    </div>
</div>


<br/>


